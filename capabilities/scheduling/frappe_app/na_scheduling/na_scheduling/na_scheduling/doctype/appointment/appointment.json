{
  "doctype": "DocType",
  "name": "Appointment",
  "module": "NA Scheduling",
  "autoname": "format:APT-{#####}",
  "engine": "InnoDB",
  "field_order": [
    "customer",
    "start_time",
    "duration_minutes",
    "status",
    "approval_required",
    "approval_reason"
  ],
  "fields": [
    {
      "fieldname": "customer",
      "fieldtype": "Data",
      "label": "Customer"
    },
    {
      "fieldname": "start_time",
      "fieldtype": "Datetime",
      "label": "Start Time",
      "reqd": 1
    },
    {
      "fieldname": "duration_minutes",
      "fieldtype": "Int",
      "label": "Duration Minutes",
      "default": "30"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending\nConfirmed\nCancelled",
      "default": "Pending"
    },
    {
      "fieldname": "approval_required",
      "fieldtype": "Check",
      "label": "Approval Required",
      "default": "0"
    },
    {
      "fieldname": "approval_reason",
      "fieldtype": "Small Text",
      "label": "Approval Reason"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
