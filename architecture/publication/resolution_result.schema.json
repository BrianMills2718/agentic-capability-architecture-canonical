{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider Resolution Result",
  "type": "object",
  "required": ["schema_version", "source_system_spec", "bindings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_system_spec": {"type": ["object", "null"]},
    "publication_source": {"type": ["string", "null"]},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "semantic_action",
          "capability_owner",
          "selected_implementation",
          "composition_implementation_ref",
          "owner_manifest",
          "input_contracts",
          "input_sources",
          "output_contracts",
          "provenance",
          "requirement_invariants"
        ],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "semantic_action": {"type": "string", "minLength": 1},
          "capability_owner": {"type": "string", "minLength": 1},
          "selected_implementation": {"type": "string", "minLength": 1},
          "composition_implementation_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*/[1-9][0-9]*$"},
          "owner_manifest": {"type": "string", "minLength": 1},
          "input_contracts": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "input_sources": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {"kind": {"const": "external"}},
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["kind", "requirement_id", "output_name"],
                  "properties": {
                    "kind": {"const": "requirement_output"},
                    "requirement_id": {"type": "string", "minLength": 1},
                    "output_name": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "output_contracts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "provenance": {"type": "object"},
          "requirement_invariants": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
