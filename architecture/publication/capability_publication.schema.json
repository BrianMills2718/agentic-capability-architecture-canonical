{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/capability_publication.schema.json",
  "title": "Capability Publication",
  "type": "object",
  "required": ["schema_version", "published_actions", "publication_rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_registry": {"type": "string", "minLength": 1},
    "published_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["semantic_action", "capability_owner", "selected_implementation", "owner_manifest", "semantic_contract"],
        "properties": {
          "semantic_action": {"type": "string", "minLength": 1},
          "capability_owner": {"type": "string", "minLength": 1},
          "implementation_candidates": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "selected_implementation": {"type": "string", "minLength": 1},
          "owner_manifest": {"type": "string", "minLength": 1},
          "semantic_contract": {
            "type": "object",
            "required": ["inputs", "outputs"],
            "properties": {
              "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "invariants": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "publication_rules": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
