{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Registry",
  "type": "object",
  "required": [
    "schema_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "version",
          "path",
          "provides",
          "requires"
        ],
        "properties": {
          "status": {
            "enum": [
              "candidate",
              "proven",
              "core"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "runtime_path": {
            "type": "string",
            "minLength": 1
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "optional": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "foundation": {
            "type": "boolean"
          },
          "evidence": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
