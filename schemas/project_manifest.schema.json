{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Manifest",
  "type": "object",
  "required": [
    "project",
    "capabilities",
    "configuration",
    "custom_extensions"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "purpose": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "configuration": {
      "type": "object"
    },
    "custom_extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptance_scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reuse_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
