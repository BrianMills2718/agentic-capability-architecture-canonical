{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reuse Candidate Log",
  "type": "object",
  "required": [
    "schema_version",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "project",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "project": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "observed",
              "candidate",
              "promoted",
              "rejected"
            ]
          },
          "similar_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
