{
  "doctype": "DocType",
  "name": "Maintenance Request",
  "module": "Maintenance Requests",
  "autoname": "format:MRQ-{#####}",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "requester",
      "label": "Requester",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "location",
      "label": "Location",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "asset_tag",
      "label": "Asset Tag",
      "fieldtype": "Data"
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Select",
      "options": "Electrical\nPlumbing\nHVAC\nEquipment\nSafety\nOther",
      "reqd": 1
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "default": "Normal",
      "reqd": 1
    },
    {
      "fieldname": "photo",
      "label": "Issue Photo",
      "fieldtype": "Attach"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "New\nAssigned\nIn Progress\nCompleted\nClosed",
      "default": "New",
      "read_only": 1
    },
    {
      "fieldname": "assigned_to",
      "label": "Assigned To",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "assigned_by",
      "label": "Assigned By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "assigned_at",
      "label": "Assigned At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "due_at",
      "label": "SLA Due At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "started_at",
      "label": "Started At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "completed_at",
      "label": "Completed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "closed_at",
      "label": "Closed At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "resolution",
      "label": "Resolution",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "completion_photo",
      "label": "Completion Photo",
      "fieldtype": "Attach"
    },
    {
      "fieldname": "overdue_notified_at",
      "label": "Overdue Notified At",
      "fieldtype": "Datetime",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "All",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Maintenance Dispatcher",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Maintenance Technician",
      "read": 1,
      "write": 1
    }
  ]
}
