{
  "doctype": "DocType",
  "name": "Service Intake",
  "module": "Intake Booking",
  "autoname": "format:INTAKE-{#####}",
  "engine": "InnoDB",
  "field_order": [
    "client_name",
    "email",
    "service_type",
    "request_summary",
    "requested_start_time",
    "requested_duration_minutes",
    "appointment",
    "status"
  ],
  "fields": [
    {"fieldname":"client_name","fieldtype":"Data","label":"Client Name","reqd":1},
    {"fieldname":"email","fieldtype":"Data","label":"Email","options":"Email","reqd":1},
    {"fieldname":"service_type","fieldtype":"Select","label":"Service Type","options":"Consultation\nProject Discovery\nSupport","reqd":1},
    {"fieldname":"request_summary","fieldtype":"Small Text","label":"Request Summary","reqd":1},
    {"fieldname":"requested_start_time","fieldtype":"Datetime","label":"Requested Start Time","reqd":1},
    {"fieldname":"requested_duration_minutes","fieldtype":"Select","label":"Requested Duration Minutes","options":"30\n60\n90\n120","default":"30","reqd":1},
    {"fieldname":"appointment","fieldtype":"Link","label":"Appointment","options":"Appointment","read_only":1},
    {"fieldname":"status","fieldtype":"Select","label":"Status","options":"Submitted\nPending Approval\nBooked\nCancelled","default":"Submitted","reqd":1}
  ],
  "permissions": [
    {"role":"System Manager","read":1,"write":1,"create":1,"delete":1}
  ]
}
