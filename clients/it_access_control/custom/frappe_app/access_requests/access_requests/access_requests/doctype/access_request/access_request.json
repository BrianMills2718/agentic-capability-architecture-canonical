{
  "doctype": "DocType",
  "name": "Access Request",
  "module": "Access Requests",
  "autoname": "format:AR-{#####}",
  "engine": "InnoDB",
  "field_order": [
    "requester",
    "target_user",
    "system_name",
    "access_level",
    "justification",
    "requested_until",
    "status",
    "current_approval_stage",
    "approval_events",
    "submitted_at",
    "approved_at",
    "rejected_at",
    "rejection_reason",
    "provisioned_at",
    "revoked_at"
  ],
  "fields": [
    {
      "fieldname": "requester",
      "fieldtype": "Link",
      "label": "Requester",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "target_user",
      "fieldtype": "Link",
      "label": "Target User",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "system_name",
      "fieldtype": "Data",
      "label": "System",
      "reqd": 1
    },
    {
      "fieldname": "access_level",
      "fieldtype": "Select",
      "label": "Access Level",
      "options": "Standard\nSensitive\nPrivileged",
      "default": "Standard",
      "reqd": 1
    },
    {
      "fieldname": "justification",
      "fieldtype": "Small Text",
      "label": "Justification",
      "reqd": 1
    },
    {
      "fieldname": "requested_until",
      "fieldtype": "Date",
      "label": "Requested Until"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nPending Manager Approval\nPending Security Approval\nReady to Provision\nProvisioned\nRevoked\nRejected",
      "default": "Draft",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "current_approval_stage",
      "fieldtype": "Data",
      "label": "Current Approval Stage",
      "read_only": 1
    },
    {
      "fieldname": "approval_events",
      "fieldtype": "Table",
      "label": "Approval & Access Audit",
      "options": "Access Approval Event",
      "read_only": 1
    },
    {
      "fieldname": "submitted_at",
      "fieldtype": "Datetime",
      "label": "Submitted At",
      "read_only": 1
    },
    {
      "fieldname": "approved_at",
      "fieldtype": "Datetime",
      "label": "Approved At",
      "read_only": 1
    },
    {
      "fieldname": "rejected_at",
      "fieldtype": "Datetime",
      "label": "Rejected At",
      "read_only": 1
    },
    {
      "fieldname": "rejection_reason",
      "fieldtype": "Small Text",
      "label": "Rejection Reason",
      "read_only": 1
    },
    {
      "fieldname": "provisioned_at",
      "fieldtype": "Datetime",
      "label": "Provisioned At",
      "read_only": 1
    },
    {
      "fieldname": "revoked_at",
      "fieldtype": "Datetime",
      "label": "Revoked At",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Access Requester",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Access Manager",
      "read": 1,
      "write": 1
    },
    {
      "role": "Security Approver",
      "read": 1,
      "write": 1
    },
    {
      "role": "Access Provisioner",
      "read": 1,
      "write": 1
    }
  ]
}
